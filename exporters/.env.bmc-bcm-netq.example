# NVIS Observability — BMC / BCM / NetQ exporter environment (TEMPLATE)
# =====================================================================
# Copy the relevant lines into your repo-root .env and fill in real values.
# The interactive installer (installer/install.sh) writes these for you.
# NEVER commit a filled-in .env — it is gitignored. Secrets stay here only.

# ---- Shared -----------------------------------------------------------------
CLUSTER_NAME=<YOUR_CLUSTER_NAME>          # Prometheus cluster= label on every metric
DGX_FLAVOR=                               # optional platform hint: DGXB300 / DGXB200 / DGXH100 / DGXA100

# ---- Redfish BMC exporter (:9104) -------------------------------------------
# BMC target list: written by the installer to ./secrets/bmc-targets.csv
# (gitignored) and mounted into the container. See bmc-targets.example.csv.
BMC_USER=root
BMC_PASSWORD=<BMC_PASSWORD>               # SECRET — .env only, never committed
BMC_CONCURRENCY=16                        # BMCs polled in parallel
BMC_SENSOR_CONCURRENCY=8                  # Redfish requests per BMC (keep <= 8)
BMC_VERIFY_SSL=false                      # BMC certs are usually self-signed
BMC_SCRAPE_INTERVAL=300                   # seconds between full polls
BMC_TIMEOUT=12                            # per-request timeout (seconds)
BMC_FW_DISABLED=true                      # skip slow firmware inventory unless needed
BMC_SEL_DISABLED=false                    # collect System Event Log entries

# ---- BCM (Base Command Manager) exporter (:9401) ----------------------------
# Auth is SSH-key only (mounted from ~/.ssh) — no BCM password on disk.
BCM_HOST=<BCM_HEAD_NODE_IP_OR_HOST>       # BCM head node
BCM_USER=root
BCM_JUMP=                                 # optional jump host, e.g. user@jumphost
BCM_SCRAPE_INTERVAL=60

# ---- NetQ exporter (:9109) — OPTIONAL ---------------------------------------
# Only set these if your Ethernet/Cumulus fabric is managed by NVIDIA NetQ.
NETQ_ENDPOINT=<https://netq.example.com>  # NetQ API base URL
NETQ_TOKEN=<NETQ_BEARER_TOKEN>            # SECRET — preferred; OR use user/pass below
NETQ_USER=                                # used only when no token is provided
NETQ_PASS=                                # SECRET — used only with NETQ_USER
NETQ_VERIFY_SSL=true
NETQ_SCRAPE_INTERVAL=30
