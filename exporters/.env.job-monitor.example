# -----------------------------------------------------------------------------
# Job Monitor component — environment template.
# The interview installer appends the answered values to the real .env
# (which is gitignored). Placeholders only here; NO real IPs, hosts, or secrets.
# -----------------------------------------------------------------------------

# --- llmb-job-exporter (the per-Slurm-job validation/benchmark log scraper) ---
# Root under which the harness writes per-job logs + results (shared FS / VAST mount).
SLURM_JOB_LOG_DIR=<ABSOLUTE_PATH_TO_VALIDATION_JOB_LOGS>
# Glob for the training stdout log; relative to the root above unless absolute.
# Default matches the LLMB / dgxc-benchmarking tree.
SLURM_LOG_GLOB=workloads/*/experiments/*/*/*/log-*_*_0.out
# Optional harness job registry (jobid -> workload/model/dtype/scale). Empty = skip.
SLURM_REGISTRY_SQLITE=
# cluster/platform label value used by every metric (never a hostname).
DGX_FLAVOR=dgx-superpod

# --- slurm-job-exporter (squeue/sacct -> slurm_job_info + slurm_job_node) ---
# "" = auto (ssh when BCM_HOST set, else local); "local" on the controller; "ssh" remote.
SLURM_MODE=
# SSH target + creds for ssh mode (reuse the head-node key; leave empty for local mode).
BCM_HOST=
BCM_USER=root
BCM_JUMP=
BCM_SSH_PORT=22
# squeue/sacct location if not on PATH, and slurm.conf when there is no DNS SRV.
SLURM_BIN=
SLURM_CONF=<ABSOLUTE_PATH_TO_slurm.conf>
# Human-readable cluster name for labels (falls back to DGX_FLAVOR).
CLUSTER_NAME=<YOUR_CLUSTER_NAME>
# Rolling accounting window and scrape cadence.
SACCT_HOURS=24
SLURM_SCRAPE_INTERVAL=30
LLMB_EXPORTER_INTERVAL=30
