# NVIS Observability — InfiniBand fabric exporters environment template
# ======================================================================
# Copy the values you need into your .env (which the installer writes) and fill
# them in. NEVER commit .env — it holds credentials. Placeholders in <...> must
# be replaced with your site values.

# ── UFM (NVIDIA Unified Fabric Manager) REST API ─────────────────────────────
UFM_HOST=<UFM_SERVER_IP_OR_HOST>       # required by ufm / ufm-telemetry / ib-lldp / cable-audit
UFM_USER=ufmsystem                     # UFM REST username
UFM_PASSWORD=<UFM_PASSWORD>            # UFM REST password (SECRET)
UFM_VERIFY_SSL=false                   # true to verify the UFM TLS cert
UFM_VERIFY_SSL_NUM=0                   # cable-audit form of the above (0/1)
UFM_CLUSTER_MINDER=false               # true to poll the Cluster Minder plugin

# UFM Telemetry CSV endpoint (open, no auth). Default URL is
# http://$UFM_HOST:$UFM_TELEMETRY_PORT/csv/metrics
UFM_TELEMETRY_PORT=9001
UFM_TELEMETRY_URL=                     # set to override the full URL
UFM_TELEMETRY_HOST_FILTER=             # optional comma-separated host_name prefixes to scope cardinality

# ── Switch SSH (for the ib-lldp transceiver sweep + cable-audit SSH mode) ─────
SWITCH_SSH_USER=<SWITCH_ADMIN_USER>    # NVOS/switch SSH username
SWITCH_SSH_PASSWORD=<SWITCH_PASSWORD> # NVOS/switch SSH password (SECRET)
# Optional explicit switch list "name=ip,name=ip,..." (or bare IPs). Empty =>
# ib-lldp auto-discovers switch IPs from UFM.
SWITCH_LIST=

# ── Labels shared across all fabric metrics ──────────────────────────────────
CLUSTER_NAME=<YOUR_CLUSTER_NAME>       # Prometheus cluster= label
FABRIC=fabric                          # Prometheus fabric= label (e.g. east-west)
HOST_NAME_PREFIX=gpu                   # canonical compute-host hostname prefix (ib-identity)

# ── Cadence / tuning (safe defaults; override only if needed) ────────────────
UFM_SCRAPE_INTERVAL=30                 # ufm-exporter poll seconds
UFM_TELEMETRY_POLL=90                  # ufm-telemetry poll seconds
IB_LLDP_SWEEP_ENABLED=1                # 1 to run the switch SSH sweep
IB_LLDP_SWEEP_INTERVAL=1800            # seconds between LLDP sweeps
CABLE_SCAN_MODE=ufm                    # ufm (SM link view) | ssh (per-switch SSH)
CABLE_AUDIT_INTERVAL=43200             # seconds between cable audits (12h)
CABLE_ISSUE_REFRESH=60                 # ib-cable-issue file re-read seconds
CABLE_ISSUE_LOKI_URL=                  # optional Loki push URL for cable-issue log lines
SWITCH_AUDIT_REFRESH=60                # ib-switch-audit CSV re-read seconds
IB_IDENTITY_REFRESH=3600               # ib-identity rebuild seconds
