# ─────────────────────────────────────────────────────────────────────────────
# node-agents environment fragment — copy the values you need into the repo .env
# (which is gitignored). Placeholders only; NEVER commit real hosts/secrets.
# The interview installer prompts for each of these.
# ─────────────────────────────────────────────────────────────────────────────

# ── Where telemetry goes ─────────────────────────────────────────────────────
# ObsVM host/IP running Prometheus (:9090) and Loki (:3100). Required.
METRICS_TARGET=<OBSVM_HOST_OR_IP>

# Head-node stream relay the compute nodes push to. Leave equal to METRICS_TARGET
# if nodes can reach the ObsVM directly; otherwise the head-node relay host/IP.
RELAY_HOST=<HEAD_NODE_HOST_OR_IP>
RELAY_RW_PORT=19090
RELAY_LOKI_PORT=13100

# ── Labels ───────────────────────────────────────────────────────────────────
CLUSTER_NAME=<YOUR_CLUSTER_NAME>
# Hardware flavor label (free text): dgx-superpod / gb200 / h100 / ...
DGX_FLAVOR=dgx-superpod

# ── Node inventory (choose ONE) ──────────────────────────────────────────────
# 1) explicit file, one hostname per line (see nodes.txt.example)
NODE_LIST=./node-agents/nodes.txt
# 2) discover from Slurm (uncomment to use instead of NODE_LIST)
# NODE_DISCOVERY_CMD=sinfo -h -N -o %N
# 3) inline (uncomment)
# NODES="node001 node002 node003"

# ── SSH reachability to the nodes ────────────────────────────────────────────
SSH_USER=root
# ProxyJump spec if nodes are only reachable via a bastion/head node; blank=direct
SSH_JUMP=

# ── On-node paths / tuning ───────────────────────────────────────────────────
# Cluster-shared staging dir (NFS export visible to every node) that
# stage-binaries.sh populates and install-node.sh copies from.
SHARE=/cm/shared/nvis/bin
# node_exporter textfile collector directory (where the .prom collectors write).
TEXTFILE_DIR=/var/lib/node_exporter/textfile_collector
# textfile collector cadence and toggle
COLLECTOR_INTERVAL=30s
ENABLE_TEXTFILE_COLLECTORS=1
