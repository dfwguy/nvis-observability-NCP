    {
      "type": "bargauge",
      "id": 11,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "title": "Down Ports by Switch — topk(15) [LIVE-UFM]",
      "description": "Where the CABLED down ports are (speed!=Unknown; never-linked / planned-uncabled spine+leaf uplinks excluded). Click a bar → D12 blast-radius for that switch.",
      "options": {
