            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "🔎 Blast radius (D12)",
                    "url": "/d/nvis-ib-blast-radius/blast-radius?var-cluster=$cluster&var-switch=${__data.fields.switch}&${__url_time_range}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "su"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "SU"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rack"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Rack"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "role"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Role"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "speed"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Speed"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "width"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Width"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "port"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Port"
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "replica": true,
              "cluster": true,
              "dgx_flavor": true,
              "system_name": true
            },
            "renameByName": {}
          }
        }
      ],
      "targets": [
        {
          "expr": "label_replace(ufm_port_up{cluster=~\"$cluster\",speed=~\"SDR|DDR|QDR|FDR|EDR|HDR\"} == 1, \"system_name\",\"$1\",\"switch\",\"(.*)\") * on(system_name) group_left(su,rack,role) ib_switch_info or label_replace(ufm_port_up{cluster=~\"$cluster\",speed=~\"SDR|DDR|QDR|FDR|EDR|HDR\"} == 1, \"system_name\",\"$1\",\"switch\",\"(.*)\") unless on(system_name) ib_switch_info",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      }
    },
