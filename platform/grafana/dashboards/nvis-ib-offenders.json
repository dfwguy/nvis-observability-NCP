            {
              "title": "🔎 Which links? → Degraded-width detail (placement + peer switch)",
              "url": "/d/nvis-ib-offenders?viewPanel=10&var-cluster=$cluster&${__url_time_range}",
              "targetBlank": false
            }
          ],
          "noValue": "✓ Healthy",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "✓ None",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "count(ufm_port_up{cluster=~\"$cluster\",width=~\"1x|2x|3x\"} == 1) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      }
    },
    {
      "type": "stat",
      "id": 4,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "title": "Down Ports",
      "description": "CABLED ports currently DOWN — port previously negotiated a rate but is now up==0. Excludes speed=Unknown (never-linked / planned-uncabled spine+leaf uplinks), which are NOT outages. LIVE offenders only.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          },
          "unit": "short",
          "links": [
            {
              "title": "🔎 Which switches? → Down-ports by switch",
              "url": "/d/nvis-ib-offenders?viewPanel=11&var-cluster=$cluster&${__url_time_range}",
              "targetBlank": false
            }
          ],
          "noValue": "✓ Healthy",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "✓ None",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "count(ufm_port_up{cluster=~\"$cluster\",speed!=\"Unknown\"} == 0) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      }
    },
    {
      "type": "stat",
      "id": 5,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "title": "Crit Host-Links (score>0.5)",
      "description": "Host links whose live composite score exceeds 0.5 (see headline table).",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          },
          "unit": "short",
          "links": [
            {
              "title": "🔎 Which host-links? → Worst-connections detail (SU/rack/leaf)",
              "url": "/d/nvis-ib-offenders?viewPanel=7&var-cluster=$cluster&${__url_time_range}",
              "targetBlank": false
            },
            {
              "title": "📈 Signal / BER (D3)",
              "url": "/d/nvis-ib-signal/ber-signal?var-cluster=$cluster&${__url_time_range}",
              "targetBlank": false
            }
          ],
          "noValue": "✓ Healthy",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "✓ None",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "count(ib_link_health_score{cluster=~\"$cluster\"} > 0.5) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 6,
      "title": "Composite Worst-Connection Score (headline)",
      "type": "row"
    },
    {
      "type": "table",
      "id": 7,
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "title": "Worst Host-Connections — topk(40) ib_link_health_score [LIVE-HOST]",
      "description": "Live ib_link_health_score recording rule (0-100 badness, higher=worse): composite of symbol-err, link-flaps, discards & xmit-wait. Switch-side eff_ber term lands with UFM Telemetry (P3). Row → D12 blast-radius.",
      "options": {
        "sortBy": [
          {
            "displayName": "Health Score",
            "desc": true
          }
        ],
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "displayMode": "auto"
          },
          "noValue": "✓ None — fabric healthy"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Health Score"
              },
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 0.5
                    },
                    {
                      "color": "red",
                      "value": 10
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "node"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Host"
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "🔎 Blast radius (D12)",
                    "url": "/d/nvis-ib-blast-radius/blast-radius?var-cluster=$cluster&var-node=${__data.fields.node}&${__url_time_range}",
                    "targetBlank": false
                  },
                  {
                    "title": "📈 Signal (D3)",
                    "url": "/d/nvis-ib-signal/ber-signal?var-cluster=$cluster&var-node=${__data.fields.node}&${__url_time_range}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "leaf"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Connected Leaf (peer sw)"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "leaf_port"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Leaf Port"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "su"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "SU"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rack"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Rack"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "device"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "HCA"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "port"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Port"
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "replica": true,
              "cluster": true,
              "dgx_flavor": true
            },
            "renameByName": {}
          }
        }
      ],
      "targets": [
        {
          "expr": "topk(40, (ib_link_health_score{cluster=~\"$cluster\",node=~\"$node\"} > 0) * on(node,device) group_left(leaf,leaf_port,su,rack) ib_host_rail_leaf or (ib_link_health_score{cluster=~\"$cluster\",node=~\"$node\"} > 0) unless on(node,device) ib_host_rail_leaf)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      }
    },
