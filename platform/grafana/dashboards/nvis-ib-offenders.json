{
  "annotations": {
    "list": []
  },
  "description": "Unified daily-triage: slow speed (!=NDR/XDR), degraded width (<4x), down ports, and a live composite worst-connection score. Host + UFM views LIVE; SU grouping + eff_ber term gated on join/telemetry.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "type": "link",
      "title": "🏠 NVIS Home",
      "url": "/d/nvis-net-home/nvis-network-home?${__url_time_range}",
      "icon": "dashboard",
      "tooltip": "Network Observability Home",
      "targetBlank": false,
      "keepTime": true
    },
    {
      "type": "dashboards",
      "title": "Network Boards",
      "tags": [
        "network"
      ],
      "asDropdown": true,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "title": "Worst-Connection Severity",
      "type": "row"
    },
    {
      "type": "stat",
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "title": "Slow Links (< NDR/XDR)",
      "description": "Active ports negotiated below NDR/XDR (Unknown excluded = down/unprovisioned, not slow).",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          },
          "unit": "short",
          "links": [
            {
              "title": "🔎 Which links? → Slow-links detail (placement + peer switch)",
              "url": "/d/nvis-ib-offenders?viewPanel=9&var-cluster=$cluster&${__url_time_range}",
              "targetBlank": false
            }
          ],
          "noValue": "✓ Healthy",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "✓ None",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "count(ufm_port_up{cluster=~\"$cluster\",speed=~\"SDR|DDR|QDR|FDR|EDR|HDR\"} == 1) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      }
    },
    {
      "type": "stat",
      "id": 3,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "title": "Degraded Width (<4x)",
      "description": "Active ports with a dead lane in the OSFP cage (1x/2x/3x).",
      "options": {
        "reduceOptions": {
