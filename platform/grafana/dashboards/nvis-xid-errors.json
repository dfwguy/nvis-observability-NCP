      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki_datasource}"
          },
          "editorMode": "code",
          "expr": "count(sum by (node, gpu, pci, xid) (count_over_time({cluster=~\"$cluster\", filename=~\"/var/log/(kern.log|syslog)\", node=~\"$node\"} |~ \"(?i)xid\" !~ \"Xid [(][^)]*[)]: (13|31|32|43|45)[,:]\" | regexp \"(?i)xid *(?:[(]pci:[0-9a-f:]+[)] *:)? *(?P<xid>[0-9]+)\" | regexp \"(?i)for gpu (?P<gpu>[0-9]+)\" | regexp \"(?i)pci:(?P<pci>[0-9a-f:]+)\" [$__range])))",
          "legendFormat": "Distinct incidents",
          "queryType": "instant",
          "refId": "A"
        },
        {
