    {
      "datasource": {
        "type": "loki",
        "uid": "${loki_datasource}"
      },
      "description": "Left = DISTINCT incidents, right = RAW log lines, both over the selected range. An incident = a unique (node, gpu/pci, xid) combination; every re-log of that same combo collapses into ONE incident (whole-range coalescing). DCGM health-watch re-emits the same XID every poll cycle, so the raw count is hugely inflated versus the number of real events. The gap between the two numbers IS the DCGM re-log noise. Distinct = count(distinct (node,gpu,pci,xid)); Raw = count of all matching log lines. This stat is computed with metric LogQL (not sampled/maxLines-limited), so it is the authoritative headline count. Benign/app-level XIDs (13,31,32,43,45) excluded; genuine hardware XIDs only.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "displayName": "Distinct incidents vs raw log lines",
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "green",
                  "text": "✓ Healthy"
                }
              },
              "type": "value"
            }
          ],
          "noValue": "✓ No incidents — healthy",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 43
