          {
            "matcher": {
              "id": "byName",
              "options": "Issues"
            },
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 20
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Switch"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "🔌 Cabling worklist",
                    "url": "/d/nvis-ib-cabling/?var-cluster=$cluster&${__url_time_range}",
                    "targetBlank": false
                  },
                  {
                    "title": "💥 Blast radius (this switch)",
                    "url": "/d/nvis-ib-blast-radius/?var-cluster=$cluster&var-switch=${__data.fields.Switch}&var-leaf=${__data.fields.Switch}&${__url_time_range}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "replica": true,
              "dgx_flavor": true,
              "cluster": true,
              "fabric": true,
              "endpoint": true,
              "container": true,
              "namespace": true,
              "pod": true,
              "service": true
            },
            "renameByName": {
              "switch": "Switch",
              "su": "SU",
              "rack": "Rack",
              "role": "Role",
              "Value": "Issues"
            }
          }
        }
      ],
      "targets": [
        {
          "expr": "topk(25, ib_cable_issue_by_switch{cluster=~\"$cluster\",su=~\"SU1|SU2\"} * on(switch) group_left(rack,role) label_replace(ib_switch_info, \"switch\", \"$1\", \"system_name\", \"(.*)\"))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      }
    }
  ],
