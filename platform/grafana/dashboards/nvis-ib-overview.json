{
  "annotations": {
    "list": []
  },
  "description": "Top scorecard for the DGX SuperPOD IB fabric: switch/link/port counts, alarms, topology distribution and trends.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "type": "link",
      "title": "🏠 NVIS Home",
      "url": "/d/nvis-net-home/nvis-network-home?${__url_time_range}",
      "icon": "dashboard",
      "tooltip": "Network Observability Home",
      "targetBlank": false,
      "keepTime": true
    },
    {
      "type": "dashboards",
      "title": "Network Boards",
      "tags": [
        "network"
      ],
      "asDropdown": true,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "title": "Fabric Scorecard (LIVE-UFM)",
      "type": "row"
    },
    {
      "type": "stat",
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "title": "UFM Exporter",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max(ufm_up) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      }
    },
    {
      "type": "stat",
      "id": 3,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "title": "Switches",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
