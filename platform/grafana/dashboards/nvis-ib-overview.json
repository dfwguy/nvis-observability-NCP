              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "red",
                    "value": null
                  },
                  {
                    "color": "orange",
                    "value": 70
                  },
                  {
                    "color": "green",
                    "value": 90
                  }
                ]
              },
              "min": 0,
              "max": 100,
              "unit": "short",
              "noValue": "⏳ Waiting: LLDP-IB UMAD scan (P2)"
            },
            "overrides": []
          },
          "targets": [
            {
              "expr": "ibl_fabric_health_score{cluster=~\"$cluster\"}",
              "legendFormat": "",
              "refId": "A"
            }
          ],
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "description": "NEW-IBL 0-100 (pending ib-lldp ibl_* exporter — design Appendix B)"
        },
