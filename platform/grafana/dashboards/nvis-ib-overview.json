              {
                "color": "text",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "n/a",
                  "color": "text",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(ufm_link_active_count{cluster=~\"$cluster\"}) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "UFM exporter does not populate active-link count in this build: ufm_link_active_count has been flat 0 for the full retention window while ufm_link_count and ufm_port_active_count are live. Shown as 'n/a' rather than a false 0. Track link/port health via 'Links (total)', 'Ports Active', and 'Ports by Physical State'."
    },
