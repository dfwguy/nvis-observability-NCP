        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Events",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "displayMode": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Events"
              },
              {
                "id": "custom.displayMode",
                "value": "color-background"
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "replica": true,
              "dgx_flavor": true,
              "endpoint": true,
              "container": true,
              "namespace": true,
              "pod": true,
              "service": true
            },
            "renameByName": {}
          }
        }
      ],
      "targets": [
