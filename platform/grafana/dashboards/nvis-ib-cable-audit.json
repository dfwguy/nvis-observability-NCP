      "title": "NEW since last audit",
      "description": "Miswiring faults that appeared since the previous scan (cur − prev). Guarded by compare_available; reads 'no prior scan' until the second 12h run.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short",
          "noValue": "no prior scan",
          "links": [
            {
              "title": "🔎 Which items? → Changed items table",
