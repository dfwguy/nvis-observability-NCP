    {
      "type": "timeseries",
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "title": "Are we winning? — current total vs per-run NEW / RESOLVED",
      "description": "Each 12h step: the current-total line should trend DOWN if fixes outpace new miscablings. NEW and RESOLVED bars show the per-run delta.",
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 6,
            "showPoints": "auto",
            "spanNulls": true,
            "axisPlacement": "auto"
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "current total"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "new this run"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.drawStyle",
                "value": "bars"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "resolved this run"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              },
              {
                "id": "custom.drawStyle",
                "value": "bars"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum(ib_cable_issue_by_switch{fabric=\"EW\"})",
          "legendFormat": "current total",
          "refId": "A"
        },
        {
          "expr": "sum(ib_cable_issue_new_total)",
          "legendFormat": "new this run",
          "refId": "B"
        },
        {
          "expr": "sum(ib_cable_issue_resolved_total)",
          "legendFormat": "resolved this run",
          "refId": "C"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      }
    },
