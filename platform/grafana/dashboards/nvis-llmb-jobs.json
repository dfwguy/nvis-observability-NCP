{
  "uid": "nvis-llmb-jobs",
  "title": "🏃 Benchmark Jobs — Progress & Health (LLMB)",
  "tags": [
    "nvis",
    "llmb"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "JobID",
        "type": "query",
        "label": "JobID",
        "datasource": {
          "type": "prometheus",
          "uid": "nvis-victoriametrics"
        },
        "definition": "label_values(llmb_job_info, jobid)",
        "query": {
          "query": "label_values(llmb_job_info, jobid)",
          "refId": "A"
        },
        "refresh": 2,
        "sort": 3,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".+"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Jobs (selected)",
      "datasource": {
        "type": "prometheus",
        "uid": "nvis-victoriametrics"
      },
      "description": "",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nvis-victoriametrics"
          },
          "expr": "count(llmb_job_info{jobid=~\"$JobID\"})",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "editorMode": "code",
          "legendFormat": "{{jobid}} {{model}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Completed (step==total)",
      "datasource": {
        "type": "prometheus",
        "uid": "nvis-victoriametrics"
      },
      "description": "jobs whose log reached the final step",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nvis-victoriametrics"
          },
          "expr": "count(llmb_job_step{jobid=~\"$JobID\"} == llmb_job_total_steps) or vector(0)",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "editorMode": "code",
          "legendFormat": "{{jobid}} {{model}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active (log <2m fresh)",
      "datasource": {
        "type": "prometheus",
        "uid": "nvis-victoriametrics"
      },
      "description": "",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nvis-victoriametrics"
          },
          "expr": "count(llmb_job_log_age_seconds{jobid=~\"$JobID\"} < 120) or vector(0)",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "editorMode": "code",
          "legendFormat": "{{jobid}} {{model}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "STALLED (log >5m, not done)",
      "datasource": {
        "type": "prometheus",
        "uid": "nvis-victoriametrics"
      },
      "description": "log stopped advancing but job not at final step — hang",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nvis-victoriametrics"
          },
          "expr": "count((llmb_job_log_age_seconds{jobid=~\"$JobID\"} > 300) unless (llmb_job_step == llmb_job_total_steps)) or vector(0)",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "editorMode": "code",
          "legendFormat": "{{jobid}} {{model}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "NaN detected",
      "datasource": {
        "type": "prometheus",
        "uid": "nvis-victoriametrics"
      },
      "description": "",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nvis-victoriametrics"
          },
          "expr": "count(llmb_job_nan_iterations{jobid=~\"$JobID\"} > 0) or vector(0)",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "editorMode": "code",
          "legendFormat": "{{jobid}} {{model}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Slowest step (s)",
      "datasource": {
        "type": "prometheus",
        "uid": "nvis-victoriametrics"
      },
      "description": "",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nvis-victoriametrics"
          },
          "expr": "max(llmb_job_step_seconds{jobid=~\"$JobID\"} and llmb_job_log_age_seconds < 120) or vector(0)",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "editorMode": "code",
          "legendFormat": "{{jobid}} {{model}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "All benchmark jobs — progress · perf · health",
      "datasource": {
        "type": "prometheus",
        "uid": "nvis-victoriametrics"
      },
      "gridPos": {
        "h": 18,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nvis-victoriametrics"
          },
          "expr": "llmb_job_step{jobid=~\"$JobID\"}",
          "refId": "A",
          "format": "table",
          "instant": true,
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nvis-victoriametrics"
          },
          "expr": "llmb_job_total_steps{jobid=~\"$JobID\"}",
          "refId": "B",
          "format": "table",
          "instant": true,
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nvis-victoriametrics"
          },
          "expr": "llmb_job_total_steps{jobid=~\"$JobID\"} - llmb_job_step{jobid=~\"$JobID\"}",
          "refId": "C",
          "format": "table",
          "instant": true,
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nvis-victoriametrics"
          },
          "expr": "(llmb_job_total_steps{jobid=~\"$JobID\"} - llmb_job_step{jobid=~\"$JobID\"}) * on(jobid) group_left llmb_job_step_seconds{jobid=~\"$JobID\"}",
          "refId": "D",
          "format": "table",
          "instant": true,
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nvis-victoriametrics"
          },
          "expr": "llmb_job_step_seconds{jobid=~\"$JobID\"}",
          "refId": "E",
          "format": "table",
          "instant": true,
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nvis-victoriametrics"
          },
          "expr": "llmb_job_tflops_per_gpu{jobid=~\"$JobID\"}",
          "refId": "F",
          "format": "table",
          "instant": true,
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nvis-victoriametrics"
          },
          "expr": "llmb_job_nan_iterations{jobid=~\"$JobID\"}",
          "refId": "G",
          "format": "table",
          "instant": true,
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nvis-victoriametrics"
          },
          "expr": "llmb_job_log_age_seconds{jobid=~\"$JobID\"}",
          "refId": "H",
          "format": "table",
          "instant": true,
          "editorMode": "code"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "cluster": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "renameByName": {
              "jobid": "Job",
              "workload": "Workload",
              "model": "Model",
              "size": "Size",
              "dtype": "dtype",
              "scale": "GPUs",
              "Value #A": "Step",
              "Value #B": "Total",
              "Value #C": "Remaining",
              "Value #D": "ETA (s)",
              "Value #E": "Sec/step",
              "Value #F": "TFLOP/GPU",
              "Value #G": "NaN",
              "Value #H": "Log age (s)"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Job",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "NaN"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Log age (s)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 120
                    },
                    {
                      "color": "red",
                      "value": 300
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ETA (s)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Sec/step"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Step time (s) — $JobID",
      "datasource": {
        "type": "prometheus",
        "uid": "nvis-victoriametrics"
      },
      "description": "per-step wallclock; spikes = interconnect/compute jitter",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nvis-victoriametrics"
          },
          "expr": "llmb_job_step_seconds{jobid=~\"$JobID\"}",
          "refId": "A",
          "format": "time_series",
          "instant": false,
          "editorMode": "code",
          "legendFormat": "{{jobid}} {{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "TFLOP/s per GPU — $JobID",
      "datasource": {
        "type": "prometheus",
        "uid": "nvis-victoriametrics"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nvis-victoriametrics"
          },
          "expr": "llmb_job_tflops_per_gpu{jobid=~\"$JobID\"}",
          "refId": "A",
          "format": "time_series",
          "instant": false,
          "editorMode": "code",
          "legendFormat": "{{jobid}} {{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    }
  ],
  "id": null
}
