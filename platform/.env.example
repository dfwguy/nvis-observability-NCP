# =============================================================================
# NVIS Observability Appliance — central stack environment template.
# Copy to .env and fill in your values before `docker compose up`.
# The interview installer (installer/install.sh) writes this for you.
# NEVER commit .env — it is gitignored.
# =============================================================================

# Human-readable cluster name. Becomes the `cluster` label on all series/logs
# and the default dashboard scope. Lowercase, alnum + dashes.
CLUSTER_NAME=dgx-superpod

# DGX hardware flavor of this cluster. One of:
#   B300 | B200 | B100 | H200 | H100 | A100 | custom
DGX_FLAVOR=B300

# Grafana admin password (first-boot only). CHANGE THIS. Secret — .env only.
GRAFANA_ADMIN_PASSWORD=changeme

# Long-term metrics retention in VictoriaMetrics, in months.
DATA_RETENTION_MONTHS=12

# --- prometheus.yml.tmpl rendering (only used by the installer/envsubst) ------
# Host:port base where the site exporters listen, as seen from the Prometheus
# container. Exporters run with network_mode: host on this box, so the docker
# host-gateway alias is correct for a single-host deploy. Point elsewhere only
# if your exporters run on a different host.
EXPORTER_HOST=host.docker.internal

# Global Prometheus scrape interval.
PROM_SCRAPE_INTERVAL=15s

# VictoriaMetrics remote_write endpoint (compose DNS name; leave as-is).
VM_REMOTE_WRITE_URL=http://victoriametrics:8428/api/v1/write
